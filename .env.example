# AgentProof backend configuration.
# Copy this file to .env if you use a loader, or export these directly —
# the backend reads process.env at startup with sensible defaults for
# everything, so a clean checkout runs with zero configuration.

# Port the Express API listens on.
PORT=4000

# Where AgentProof stores its own operational data (executions + evidence
# receipts) as JSON files. Defaults to backend/data if unset.
# AGENTPROOF_DATA_DIR=./data

# --- Durable storage on Vercel ------------------------------------------
# Vercel's filesystem is read-only outside /tmp, and /tmp doesn't survive a
# cold start, so the JSON file store above only works as a demo cache there
# (see docs/LIMITATIONS.md). To make the evidence vault and audit timeline
# durable on Vercel, attach a Redis integration from the Vercel dashboard
# (Storage -> Marketplace Database Providers -> a Redis provider such as
# Upstash -> Connect Project). Vercel injects one of these pairs for you —
# nothing to set here by hand, this is just what the backend looks for:
# KV_REST_API_URL / KV_REST_API_TOKEN
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Once either pair is present, backend/src/storeBackend.ts switches to Redis
# automatically — redeploy after attaching the integration for it to take effect.

# --- CooL evidence plane -----------------------------------------------
# Uncomment to point the evidence plane at a real Phala dstack guest agent
# instead of the built-in simulator. Every receipt is honestly labelled
# `simulated` until this is set and reachable.
# COOL_DSTACK_ENDPOINT=/var/run/dstack.sock

# Content digest of this deployment's image, recorded in every receipt's
# software-identity block when set.
# COOL_IMAGE_DIGEST=sha256:...
