# AgentProof backend configuration.
# Copy this file to .env if you use a loader, or export these directly —
# the backend reads process.env at startup with sensible defaults for
# everything, so a clean checkout runs with zero configuration.

# Port the Express API listens on.
PORT=4000

# Where AgentProof stores its own operational data (executions + evidence
# receipts) as JSON files. Defaults to backend/data if unset.
# AGENTPROOF_DATA_DIR=./data

# --- CooL evidence plane -----------------------------------------------
# Uncomment to point the evidence plane at a real Phala dstack guest agent
# instead of the built-in simulator. Every receipt is honestly labelled
# `simulated` until this is set and reachable.
# COOL_DSTACK_ENDPOINT=/var/run/dstack.sock

# Content digest of this deployment's image, recorded in every receipt's
# software-identity block when set.
# COOL_IMAGE_DIGEST=sha256:...
